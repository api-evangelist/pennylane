{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pennylane Company Account Suppliers API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Suppliers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List suppliers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pennylane.com/api/external/v2/suppliers"
          },
          "docs": "Requires scope: suppliers:readonly or suppliers:all."
        },
        {
          "info": {
            "name": "Create a supplier",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.pennylane.com/api/external/v2/suppliers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires scope: suppliers:all."
        },
        {
          "info": {
            "name": "Retrieve a supplier",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pennylane.com/api/external/v2/suppliers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Internal Pennylane resource id (v2 uses internal ids only, not source_id)."
              }
            ]
          },
          "docs": "Retrieve a supplier"
        },
        {
          "info": {
            "name": "Update a supplier",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.pennylane.com/api/external/v2/suppliers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Internal Pennylane resource id (v2 uses internal ids only, not source_id)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a supplier"
        }
      ]
    }
  ],
  "bundled": true
}