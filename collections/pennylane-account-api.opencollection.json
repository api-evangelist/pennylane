{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pennylane Company Account API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "User profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pennylane.com/api/external/v2/me"
          },
          "docs": "Returns information about the company and the user associated to the token."
        }
      ]
    }
  ],
  "bundled": true
}